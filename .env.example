# Copy to .env and fill in the values.
# Variables are validated at runtime by @repo/env (see packages/env).

# --- Server ---
# Only available on the server. Never exposed to the browser.
NODE_ENV=development
# Postgres connection string. Optional: without it the app skips persistence
# and the contact form still validates. Used by @repo/db (Drizzle ORM).
# DATABASE_URL=postgres://user:pass@localhost:5432/starterkit

# --- Authentication (optional) ---
# Auth turns on only when all three values below are set. Generate a secret with
# `openssl rand -base64 48`. When unset, the /dashboard, /messages and /settings
# routes stay open (convenient for local development and CI).
# SESSION_SECRET=
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# --- Abuse protection (optional) ---
# Fixed-window rate limit applied to POST /api/contact and the contact action.
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=60000
# Stricter fixed-window limit applied to login attempts, to blunt brute force.
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Cloudflare Turnstile secret. When set, the contact form requires a CAPTCHA.
# TURNSTILE_SECRET_KEY=

# --- Client ---
# Prefixed with NEXT_PUBLIC_ so the bundler inlines them into the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Turnstile site key shown in the contact form (pair with TURNSTILE_SECRET_KEY).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Dev only ---
# Comma-separated hostnames allowed to request dev assets (HMR) when the dev
# server is exposed through a tunnel or remote host, e.g. "*.tunnel.example.com".
# ALLOWED_DEV_ORIGINS=
