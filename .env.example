# Copy to .env and fill in the values.
# Variables are validated at runtime by @repo/env (see packages/env).

# --- Server ---
# Only available on the server. Never exposed to the browser.
NODE_ENV=development
# Optional. Any valid URL (e.g. a Postgres connection string).
# DATABASE_URL=postgres://user:pass@localhost:5432/db

# --- Client ---
# Prefixed with NEXT_PUBLIC_ so the bundler inlines them into the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
